# Kopieren Sie diese Datei nach ".env" und tragen Sie Ihre Werte ein.

# Pflicht: Passwort für die Anmeldung an der Plattform (mindestens 8 Zeichen)
ADMIN_PASSWORD=

# Optional, empfohlen auf einem Server: öffentliche Adresse der Plattform (ohne / am Ende).
# Wird für Ein-Klick-Abmelde-Links und für "Mit Google verbinden" gebraucht.
# Beispiel: https://mail.ihre-firma.de
PUBLIC_BASE_URL=

# Nur für HTTPS mit Caddy (docker compose --profile https): die Domain, z. B. mail.ihre-firma.de
DOMAIN=

# Optional: Claude-API-Schlüssel (alternativ in den Einstellungen der Plattform hinterlegen)
ANTHROPIC_API_KEY=

# Optional: festes Claude-Modell. Leer = automatisch das neueste Opus-Modell.
CLAUDE_MODEL=

# Optional: Google OAuth für "Mit Google verbinden" (alternativ in den Einstellungen)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: eigenes Geheimnis zum Verschlüsseln gespeicherter Zugangsdaten.
# Leer = wird beim ersten Start automatisch im Datenordner erzeugt (data/app-secret.key).
APP_SECRET=

# Optional: Port der Plattform (Standard 3000)
PORT=3000
